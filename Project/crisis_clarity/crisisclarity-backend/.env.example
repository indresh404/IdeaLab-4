# CrisisClarity Backend - Environment Variables Example
# Copy this to .env and fill in the values

# Groq API Key (for LLM reasoning)
GROQ_API_KEY=your_groq_api_key_here

# Sarvam API Key (for translation and TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# News API Key (for data collection)
NEWS_API_KEY=your_news_api_key_here

# Firebase Admin SDK (Optional if using local JSON fallback)
FIREBASE_SERVICE_ACCOUNT_JSON=crisisclarity-firebase-adminsdk.json

# Server Config
PORT=8000
HOST=0.0.0.0
